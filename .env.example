# Copy to .env on the host running the harness service — never commit .env.
# Live host: the VPS (/home/harness/abc/.env, chmod 600). This template lists
# exactly the variables the code reads; anything else is ignored.

# --- GitHub App (src/github.ts, src/service.ts) ---
GITHUB_APP_ID=
# Absolute path to the App private key .pem (chmod 600, outside the repo).
GITHUB_PRIVATE_KEY_PATH=
WEBHOOK_SECRET=

# --- GitHub OAuth (console login; separate OAuth App, see docs/GITHUB_APP.md) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Public base URL of the console (OAuth callback = $PUBLIC_BASE_URL/auth/callback)
PUBLIC_BASE_URL=https://piagentdev.tail2a29a7.ts.net

# --- Target repo (single repo for v1) ---
REPO=vernanng/abc

# --- Models (OpenRouter API, pi-ai provider: openrouter) ---
OPENROUTER_API_KEY=
# OpenRouter model IDs; reviewer must be a DIFFERENT family than worker.
WORKER_MODEL=deepseek/deepseek-v4.1-flash
REVIEWER_MODEL=meta/muse-spark-1.3-contributor
TRIAGE_MODEL=z-ai/glm-5.3

# --- Budget (USD, hard cap per job; over-budget jobs are parked) ---
BUDGET_PER_JOB_USD=2

# --- Optional service settings (defaults shown) ---
# PORT=8971
# ABC_STORAGE_PATH=./agent.sqlite
# ABC_WORKTREE_ROOT=./worktrees
# ABC_REVERT_AFTER_MINUTES=30

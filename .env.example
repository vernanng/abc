# Copy to .env (local proof) — never commit .env. On Cloudflare these become
# Worker secrets (wrangler secret put <NAME>), not a deployed file.

# --- GitHub App (agent identity: webhooks + PR/merge API) ---
GITHUB_APP_ID=
# Path to the App private key .pem locally; on Cloudflare, paste PEM as secret.
GITHUB_PRIVATE_KEY_PATH=
WEBHOOK_SECRET=

# --- GitHub OAuth (website login, SPEC: live collaborator check) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Target repo (single repo for v1) ---
REPO=owner/name

# --- Models (OpenCode Console API, no local OpenCode instance) ---
# One Console API key for all roles (pi-ai provider: opencode).
OPENCODE_API_KEY=
# Model IDs from the Console catalog; reviewer must be a DIFFERENT family than worker.
WORKER_MODEL=
REVIEWER_MODEL=
TRIAGE_MODEL=
# Shared Console quota: cap parallel workers (SPEC 9)
MAX_CONCURRENT_WORKERS=2

# --- Budgets, USD (hard caps enforced by C9 budget guard) ---
BUDGET_PER_JOB_USD=2
BUDGET_PER_DAY_USD=10
PROOF_BUDGET_USD=25

# --- VPS (architecture B host) ---
VPS_HOST=
VPS_USER=
HARNESS_STORAGE_PATH=/var/lib/harness/agent.sqlite
WORKTREE_ROOT=/var/lib/harness/worktrees

# --- Cloudflare (v2 only, leave blank for proof) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Risk classifier overrides (comma-separated, extends SPEC 6.1 defaults) ---
SENSITIVE_PATHS=.github/,secrets/,auth/
MAX_DIFF_LINES=1000
